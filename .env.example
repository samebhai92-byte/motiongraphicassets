# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Single explicitly configured administrator Google account email.
ADMIN_EMAIL="sameeransari89368165@gmail.com"

# DOWNLOAD_SIGNING_SECRET: Secret used by server.ts to sign temporary premium download links.
# If omitted in development, server.ts generates a persistent local secret in storage/.signing-secret.
DOWNLOAD_SIGNING_SECRET=""

# STORAGE_ROOT: Directory path where unmodified original files and preview thumbnails are stored.
STORAGE_ROOT="./storage"
